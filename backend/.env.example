# Copy to .env for local development. Never commit .env.

# SERVER-ONLY SECRET. Get a key at https://aistudio.google.com/apikey. Without it, upload, parsing, readability checks and keyword matching still work;
# profiles, AI matching, rewrites and Q&A return a clear "AI not configured" error.
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data
MAX_UPLOAD_MB=5
LLM_CALLS_PER_HOUR=60
